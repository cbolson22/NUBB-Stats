<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "NUBB Stats" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <nav>
      <a href="<%= root_path %>" class="brand">NUBB Stats</a>
      <a href="<%= players_path %>" class="<%= 'active' if controller_name == 'players' %>">Players</a>
      <a href="<%= games_path %>" class="<%= 'active' if controller_name == 'games' %>">Games</a>
    </nav>

    <div class="container">
      <%= yield %>
    </div>
  </body>
</html>
