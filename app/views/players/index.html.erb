<% per_game = params[:mode] == "per_game" %>
<%
  active_filter_count = @selected_seasons.size +
                        @selected_class_years.size +
                        @selected_game_types.size +
                        (@start_date.present? || @end_date.present? ? 1 : 0) +
                        @stat_filters.size
%>

<div class="page-header">
  <h1>Player Stats</h1>

  <details class="filter-panel" <%= "open" if active_filter_count > 0 %>>
    <summary class="filter-panel-toggle">
      Filters<% if active_filter_count > 0 %> <span class="filter-badge"><%= active_filter_count %></span><% end %>
    </summary>

    <%= form_with url: players_path, method: :get, data: { turbo: false } do |f| %>
      <%= f.hidden_field :mode, value: params[:mode] %>
      <%= f.hidden_field :sort, value: @sort_col %>
      <%= f.hidden_field :dir, value: @sort_dir %>

      <div class="filter-sections">
        <div class="filter-section">
          <div class="filter-section-title">Season</div>
          <div class="filter-checkboxes">
            <% @seasons.each do |y| %>
              <label class="filter-checkbox-label">
                <input type="checkbox" name="seasons[]" value="<%= y %>"
                       <%= "checked" if @selected_seasons.include?(y) %>>
                <%= y - 1 %>–<%= y %>
              </label>
            <% end %>
          </div>
          <div class="filter-hint">Leave blank for all seasons</div>
        </div>

        <div class="filter-section">
          <div class="filter-section-title">Class Year</div>
          <div class="filter-checkboxes">
            <% @class_years.each do |cy| %>
              <label class="filter-checkbox-label">
                <input type="checkbox" name="class_years[]" value="<%= cy %>"
                       <%= "checked" if @selected_class_years.include?(cy) %>>
                <%= cy.capitalize %>
              </label>
            <% end %>
          </div>
        </div>

        <div class="filter-section">
          <div class="filter-section-title">Game Type</div>
          <div class="filter-checkboxes">
            <% [["Conference", "conference"], ["Non-Conference", "nonconference"], ["Big Ten Tournament", "big_ten_tournament"], ["March Madness", "march_madness"]].each do |label, val| %>
              <label class="filter-checkbox-label">
                <input type="checkbox" name="game_types[]" value="<%= val %>"
                       <%= "checked" if @selected_game_types.include?(val) %>>
                <%= label %>
              </label>
            <% end %>
          </div>
        </div>

        <div class="filter-section">
          <div class="filter-section-title">Date Range</div>
          <div class="filter-date-range">
            <label class="filter-date-label">
              From
              <input type="date" name="start_date" value="<%= @start_date %>" class="filter-date-input">
            </label>
            <label class="filter-date-label">
              To
              <input type="date" name="end_date" value="<%= @end_date %>" class="filter-date-input">
            </label>
          </div>
        </div>

        <div class="filter-section filter-section-wide">
          <div class="filter-section-title">Stat Filters <span class="filter-hint-inline">(min / max per player, based on aggregated stats)</span></div>
          <div class="stat-filter-grid">
            <% { "G" => "games_played", "PPG" => "ppg", "RPG" => "rpg", "APG" => "apg", "SPG" => "spg", "BPG" => "bpg", "TOPG" => "topg", "FG%" => "fg_pct", "3P%" => "fg3_pct", "FT%" => "ft_pct" }.each do |label, key| %>
              <div class="stat-filter-row">
                <span class="stat-filter-label"><%= label %></span>
                <input type="number" step="0.1" min="0" name="<%= key %>_min"
                       value="<%= @stat_filters.dig(key, :min) %>"
                       placeholder="Min" class="stat-filter-input">
                <input type="number" step="0.1" min="0" name="<%= key %>_max"
                       value="<%= @stat_filters.dig(key, :max) %>"
                       placeholder="Max" class="stat-filter-input">
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <div class="filter-actions">
        <%= f.submit "Apply Filters", class: "btn-apply" %>
        <%= link_to "Reset", players_path(mode: params[:mode]), class: "btn-reset", data: { turbo: false } %>
      </div>
    <% end %>
  </details>

  <div class="toggle-group">
    <%= link_to "Totals", players_path(request.query_parameters.merge(mode: "totals")), class: "toggle-btn #{per_game ? '' : 'active'}", data: { turbo: false } %>
    <%= link_to "Per Game", players_path(request.query_parameters.merge(mode: "per_game")), class: "toggle-btn #{per_game ? 'active' : ''}", data: { turbo: false } %>
  </div>
</div>

<table class="stats-table">
  <% base = request.query_parameters %>
  <thead>
    <tr>
      <th>Player</th>
      <th><%= @selected_seasons.one? || @selected_class_years.any? ? "Year" : "" %></th>
      <th><%= sort_link("G", "games_played", @sort_col, @sort_dir, base) %></th>
      <% if per_game %>
        <th><%= sort_link("PPG", "ppg", @sort_col, @sort_dir, base) %></th>
        <th><%= sort_link("RPG", "rpg", @sort_col, @sort_dir, base) %></th>
        <th><%= sort_link("APG", "apg", @sort_col, @sort_dir, base) %></th>
        <th><%= sort_link("SPG", "spg", @sort_col, @sort_dir, base) %></th>
        <th><%= sort_link("BPG", "bpg", @sort_col, @sort_dir, base) %></th>
        <th><%= sort_link("TOPG", "topg", @sort_col, @sort_dir, base) %></th>
        <th><%= sort_link("FGM", "fgm_pg", @sort_col, @sort_dir, base) %></th>
        <th><%= sort_link("FGA", "fga_pg", @sort_col, @sort_dir, base) %></th>
        <th><%= sort_link("FG%", "fg_pct", @sort_col, @sort_dir, base) %></th>
        <th><%= sort_link("3PM", "fg3m_pg", @sort_col, @sort_dir, base) %></th>
        <th><%= sort_link("3PA", "fg3a_pg", @sort_col, @sort_dir, base) %></th>
        <th><%= sort_link("3P%", "fg3_pct", @sort_col, @sort_dir, base) %></th>
        <th><%= sort_link("FTM", "ftm_pg", @sort_col, @sort_dir, base) %></th>
        <th><%= sort_link("FTA", "fta_pg", @sort_col, @sort_dir, base) %></th>
        <th><%= sort_link("FT%", "ft_pct", @sort_col, @sort_dir, base) %></th>
      <% else %>
        <th><%= sort_link("PTS", "total_pts", @sort_col, @sort_dir, base) %></th>
        <th><%= sort_link("REB", "total_reb", @sort_col, @sort_dir, base) %></th>
        <th><%= sort_link("AST", "total_ast", @sort_col, @sort_dir, base) %></th>
        <th><%= sort_link("STL", "total_stl", @sort_col, @sort_dir, base) %></th>
        <th><%= sort_link("BLK", "total_blk", @sort_col, @sort_dir, base) %></th>
        <th><%= sort_link("TO", "total_to", @sort_col, @sort_dir, base) %></th>
        <th><%= sort_link("FGM", "total_fgm", @sort_col, @sort_dir, base) %></th>
        <th><%= sort_link("FGA", "total_fga", @sort_col, @sort_dir, base) %></th>
        <th><%= sort_link("FG%", "fg_pct", @sort_col, @sort_dir, base) %></th>
        <th><%= sort_link("3PM", "total_fg3m", @sort_col, @sort_dir, base) %></th>
        <th><%= sort_link("3PA", "total_fg3a", @sort_col, @sort_dir, base) %></th>
        <th><%= sort_link("3P%", "fg3_pct", @sort_col, @sort_dir, base) %></th>
        <th><%= sort_link("FTM", "total_ftm", @sort_col, @sort_dir, base) %></th>
        <th><%= sort_link("FTA", "total_fta", @sort_col, @sort_dir, base) %></th>
        <th><%= sort_link("FT%", "ft_pct", @sort_col, @sort_dir, base) %></th>
      <% end %>
    </tr>
  </thead>
  <tbody>
    <% @stats.each do |s| %>
      <% stat = s[:stats]; player = s[:player] %>
      <tr>
        <td><%= link_to player.name, player_path(player, season: @selected_seasons.one? ? @selected_seasons.first : "all"), class: "player-link" %></td>
        <td><%= s[:class_year]&.capitalize %></td>
        <td><%= stat.games_played.to_i %></td>
        <% if per_game %>
          <td><%= stat.ppg %></td>
          <td><%= stat.rpg %></td>
          <td><%= stat.apg %></td>
          <td><%= stat.spg %></td>
          <td><%= stat.bpg %></td>
          <td><%= stat.topg %></td>
          <td><%= stat.fgm_pg %></td>
          <td><%= stat.fga_pg %></td>
          <td><%= stat.fg_pct %>%</td>
          <td><%= stat.fg3m_pg %></td>
          <td><%= stat.fg3a_pg %></td>
          <td><%= stat.fg3_pct %>%</td>
          <td><%= stat.ftm_pg %></td>
          <td><%= stat.fta_pg %></td>
          <td><%= stat.ft_pct %>%</td>
        <% else %>
          <td><%= stat.total_pts.to_i %></td>
          <td><%= stat.total_reb.to_i %></td>
          <td><%= stat.total_ast.to_i %></td>
          <td><%= stat.total_stl.to_i %></td>
          <td><%= stat.total_blk.to_i %></td>
          <td><%= stat.total_to.to_i %></td>
          <td><%= stat.total_fgm.to_i %></td>
          <td><%= stat.total_fga.to_i %></td>
          <td><%= stat.fg_pct %>%</td>
          <td><%= stat.total_fg3m.to_i %></td>
          <td><%= stat.total_fg3a.to_i %></td>
          <td><%= stat.fg3_pct %>%</td>
          <td><%= stat.total_ftm.to_i %></td>
          <td><%= stat.total_fta.to_i %></td>
          <td><%= stat.ft_pct %>%</td>
        <% end %>
      </tr>
    <% end %>
  </tbody>
</table>
