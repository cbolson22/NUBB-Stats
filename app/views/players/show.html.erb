<div class="page-header">
  <%= link_to "← All players", players_path(season: @season_year), class: "back-link" %>
  <h1><%= @player.name %></h1>

  <%= form_with url: player_path(@player), method: :get, data: { turbo: false } do |f| %>
    <div class="filters">
      <%= f.select :season, [["All Years", "all"]] + @seasons.map { |y| ["#{y-1}–#{y}", y] }, { selected: @season_year || "all" }, { onchange: "this.form.submit()" } %>
    </div>
  <% end %>
</div>

<% if @game_stats.any? %>
  <table class="stats-table">
    <% base = request.query_parameters %>
    <% url_proc = ->(p) { player_path(@player, p) } %>
    <thead>
      <tr>
        <th><%= sort_link("Date", "date", @sort_col, @sort_dir, base, url_proc) %></th>
        <th>Opponent</th>
        <th>Result</th>
        <th>Start</th>
        <th><%= sort_link("MIN", "minutes", @sort_col, @sort_dir, base, url_proc) %></th>
        <th><%= sort_link("PTS", "points", @sort_col, @sort_dir, base, url_proc) %></th>
        <th><%= sort_link("REB", "reb_total", @sort_col, @sort_dir, base, url_proc) %></th>
        <th><%= sort_link("AST", "assists", @sort_col, @sort_dir, base, url_proc) %></th>
        <th><%= sort_link("STL", "steals", @sort_col, @sort_dir, base, url_proc) %></th>
        <th><%= sort_link("BLK", "blocks", @sort_col, @sort_dir, base, url_proc) %></th>
        <th><%= sort_link("TO", "turnovers", @sort_col, @sort_dir, base, url_proc) %></th>
        <th><%= sort_link("FG", "fgm", @sort_col, @sort_dir, base, url_proc) %></th>
        <th><%= sort_link("3P", "fg3m", @sort_col, @sort_dir, base, url_proc) %></th>
        <th><%= sort_link("FT", "ftm", @sort_col, @sort_dir, base, url_proc) %></th>
      </tr>
    </thead>
    <tbody>
      <% current_season_id = nil %>
      <% @game_stats.each do |s| %>
        <% g = s.game %>
        <% if @season_year.nil? && @sort_col == "date" && current_season_id && g.season_id != current_season_id %>
          <tr class="season-divider"><td colspan="14"></td></tr>
        <% end %>
        <% current_season_id = g.season_id %>
        <tr>
          <td><%= g.date.strftime(@season_year.nil? ? "%b %-d, %Y" : "%b %-d") %></td>
          <td><%= g.home_away == "home" ? "vs" : "@" %> <%= g.opponent %></td>
          <td class="<%= g.result == 'W' ? 'result-w' : 'result-l' %>"><%= g.result %> <%= g.nu_score %>–<%= g.opp_score %></td>
          <td><%= s.starter? ? "✓" : "" %></td>
          <td><%= s.minutes.to_i %></td>
          <td><%= s.points.to_i %></td>
          <td><%= s.reb_total.to_i %></td>
          <td><%= s.assists.to_i %></td>
          <td><%= s.steals.to_i %></td>
          <td><%= s.blocks.to_i %></td>
          <td><%= s.turnovers.to_i %></td>
          <td><%= s.fgm.to_i %>–<%= s.fga.to_i %></td>
          <td><%= s.fg3m.to_i %>–<%= s.fg3a.to_i %></td>
          <td><%= s.ftm.to_i %>–<%= s.fta.to_i %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p style="color:#888;margin-top:16px;">No game stats found for this season.</p>
<% end %>
